---
import { Image } from 'astro:assets';
import { contact, images, site, whatsappHref } from '../../data/site';
import videoWebm from '../../assets/background-videos/bg-light-2.webm?url';
import videoMp4 from '../../assets/background-videos/bg-light-2-res.mp4?url';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
---

<section id="inicio" class="hero-bg">
  <div class="relative -mt-18 flex min-h-svh flex-col overflow-hidden pt-16 pb-24 sm:pb-10 lg:-mt-21 lg:pt-28">
    <Image
      src={images.pool}
      alt="Piscina desbordante con el agua cristalina"
      widths={[800, 1200, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover object-[50%_60%]"
    />
    <video autoplay muted loop playsinline aria-hidden="true" class="absolute inset-0 size-full object-cover motion-reduce:hidden">
      <source src={videoWebm} type="video/webm" />
      <source src={videoMp4} type="video/mp4" />
    </video>
    <!-- Velo solo detrás del menú: sube el contraste del texto blanco sin oscurecer el resto del video -->
    <div class="from-brand-navy/45 pointer-events-none absolute inset-x-0 top-0 h-32 bg-linear-to-b to-transparent"></div>

    <Container class="relative my-auto grid w-full items-center pb-8 gap-8 text-white lg:grid-cols-[auto_auto] lg:justify-center lg:gap-16">
      <!-- Sello giratorio: el texto da la vuelta alrededor del isotipo -->
      <div class="enter relative grid size-28 shrink-0 place-items-center rounded-full bg-white shadow-[0_0_0_6px_rgb(255_255_255/0.3),0_14px_30px_-12px_rgb(7_26_46/0.55)] lg:size-72" role="img" aria-label={`${site.name}, servicio integral`}>
        <svg viewBox="0 0 132 132" class="hero-seal absolute inset-0 size-full" aria-hidden="true">
          <defs>
            <path id="seal-ring" d="M66 66 m-52 0 a52 52 0 1 1 104 0 a52 52 0 1 1 -104 0"></path>
          </defs>
          <text class="fill-brand-blue text-[11.5px] font-bold tracking-[0.17em] uppercase">
            <textPath href="#seal-ring" textLength="323" lengthAdjust="spacing"><tspan style="fill:var(--color-cyan-700)">Servicio integral</tspan> · Samuel Piscinas ·</textPath>
          </text>
        </svg>
        <Image src={images.isotipo} alt="" width={120} class="relative w-[38%]" />
      </div>

      <div class="flex w-full max-w-3xl flex-col items-start gap-6 sm:gap-8">
        <h1 style="--d:.12s" class="enter [text-shadow:0_1px_2px_rgb(7_26_46/0.4),0_6px_28px_rgb(7_26_46/0.32)] text-[2.75rem] leading-[1.02] font-extrabold sm:text-6xl lg:text-7xl">
          Cuidamos tu piscina para que vos <span class="underline decoration-[#7cd0f2] decoration-[0.07em] underline-offset-[0.14em] [text-decoration-skip-ink:none] [text-decoration-style:wavy]">solo tengas que disfrutarla.</span>
        </h1>

        <div style="--d:.26s" class="enter flex w-full flex-wrap items-center gap-3 sm:w-auto">
          <Button href="#contacto" variant="primary" size="lg" class="w-full rounded-[14px_14px_14px_4px]! sm:w-auto">Pedir presupuesto</Button>
          <Button
            href={whatsappHref()}
            variant="whatsapp"
            size="lg"
            class="rounded-[14px_14px_14px_4px]! max-sm:hidden"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" class="size-5" />
            Escribir por WhatsApp
          </Button>
        </div>
      </div>
    </Container>

    <!-- Promesas y guía para seguir bajando, ancladas al borde inferior -->
    <div style="--d:.45s" class="enter relative flex flex-col items-center gap-6 px-6 text-white">
      <ul class="[@media(max-height:700px)]:max-sm:hidden flex w-full max-w-5xl flex-col items-center gap-1 border-t border-white/50 pt-4 text-center text-sm font-semibold [text-shadow:0_1px_8px_rgb(7_26_46/0.55)] sm:flex-row sm:flex-wrap sm:justify-center sm:gap-y-1.5 sm:text-[0.95rem] lg:flex-nowrap lg:text-base">
        {[
          { text: 'Presupuesto sin cargo', cls: '' },
          { text: 'Precio cerrado antes de empezar', cls: '' },
          { text: 'Hablás directo con Samuel', cls: 'hidden sm:block' },
          { text: contact.zone, cls: 'hidden sm:block' },
        ].map((item) => (
          <li class:list={['sm:not-first:before:mx-4 sm:not-first:before:inline-block sm:not-first:before:size-[5px] sm:not-first:before:rounded-full sm:not-first:before:bg-[#7cd0f2] sm:not-first:before:align-middle sm:not-first:before:content-[\'\']', item.cls]}>
            {item.text}
          </li>
        ))}
      </ul>
      <a href="#como-trabajamos" class="cue hidden flex-col items-center gap-1 text-xs font-semibold [text-shadow:0_1px_8px_rgb(7_26_46/0.55)] sm:flex">
        Conocé cómo trabajamos
      </a>
    </div>
  </div>
</section>
