---
import { faqs } from '../../data/home';
import { whatsappHref } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="preguntas" class="bg-white py-20 lg:py-26">
  <Container>
    <SectionHeading class="mb-10 text-center lg:mb-14">Preguntas frecuentes</SectionHeading>

    <div class="grid items-start gap-6 lg:grid-cols-[1fr_1.6fr] lg:gap-8">
      <div class="from-brand-deep to-brand-navy shadow-soft flex flex-col items-start gap-4 rounded-[2rem] bg-linear-to-br p-8 text-white lg:sticky lg:top-28 lg:p-10">
        <span class="flex size-14 items-center justify-center rounded-2xl bg-white/15">
          <Icon name="whatsapp" class="size-7" />
        </span>
        <h3 class="text-3xl leading-tight font-extrabold">¿Tenés más preguntas?</h3>
        <p class="leading-relaxed text-white/80">
          Escribile directo a Samuel: te responde él, en 24 horas laborables.
        </p>
        <Button href={whatsappHref()} variant="light" size="lg" target="_blank" rel="noopener noreferrer" class="mt-2">
          Escribir por WhatsApp
        </Button>
      </div>

      <div class="flex flex-col gap-3">
        {faqs.map((item, i) => (
          <details name="faq" open={i === 0} class="group bg-brand-mist rounded-2xl border border-sky-100 transition-colors open:bg-white open:shadow-card">
            <summary class="text-brand-navy flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-extrabold sm:p-6 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="bg-brand-sky text-brand-blue flex size-8 shrink-0 items-center justify-center rounded-full text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="px-5 pb-5 leading-relaxed text-slate-600 sm:px-6 sm:pb-6">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
