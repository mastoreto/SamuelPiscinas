---
import Icon, { type IconName } from '../ui/Icon.astro';

type Props = {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  tone?: 'whatsapp' | 'brand';
};

const { icon, label, value, href, tone = 'brand' } = Astro.props;
const external = href?.startsWith('http');
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'flex items-center gap-4 rounded-[1.25rem] border p-4 transition-colors',
    tone === 'whatsapp'
      ? 'border-emerald-200 bg-emerald-50 hover:bg-emerald-100/70'
      : 'border-slate-200 bg-slate-50 hover:bg-slate-100',
  ]}
>
  <span
    class:list={[
      'flex size-12 shrink-0 items-center justify-center rounded-2xl text-white',
      tone === 'whatsapp' ? 'bg-emerald-600' : 'bg-brand-deep',
    ]}
  >
    <Icon name={icon} class="size-6" />
  </span>
  <span>
    <span class="block text-sm font-semibold text-slate-600">{label}</span>
    <span class="text-brand-navy text-base font-bold">{value}</span>
  </span>
</Tag>
