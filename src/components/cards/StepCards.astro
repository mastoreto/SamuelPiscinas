---
import { Image } from 'astro:assets';

type Props = { steps: { title: string; text: string; src: ImageMetadata }[] };
const { steps } = Astro.props;
---

<ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, i) => (
    <li class="flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-slate-50">
      <Image src={step.src} alt="" widths={[320, 640]} sizes="(min-width: 1024px) 22vw, 50vw" class="aspect-4/3 w-full object-cover" />
      <div class="flex flex-col gap-1.5 p-5">
        <span class="bg-brand-navy flex size-8 items-center justify-center rounded-full text-sm font-extrabold text-white">{i + 1}</span>
        <h4 class="text-brand-navy mt-1 font-extrabold">{step.title}</h4>
        <p class="text-sm leading-relaxed text-slate-600">{step.text}</p>
      </div>
    </li>
  ))}
</ol>
