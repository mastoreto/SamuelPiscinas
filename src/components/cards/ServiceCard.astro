---
import type { Service } from '../../data/home';

type Props = Service & { pattern: 'ripples' | 'grid' | 'hatch' };
const { title, description, pattern } = Astro.props;
---

<article
  data-pattern={pattern}
  class="service-card relative flex flex-col gap-3 overflow-hidden rounded-[1.75rem_1.75rem_1.75rem_0.5rem] border border-line p-7"
>
  <h3 class="text-brand-navy relative text-2xl leading-tight font-bold">{title}</h3>
  <p class="relative max-w-[34ch] text-[0.9375rem] leading-relaxed text-ink-600">{description}</p>
</article>

<style>
  /* Cada servicio tiene su propia trama de fondo, en la paleta de la marca */
  .service-card[data-pattern='ripples'] {
    background:
      repeating-radial-gradient(circle at 105% 108%, transparent 0 15px, rgb(76 187 232 / 0.22) 15px 16px),
      #e4f4fc;
  }
  .service-card[data-pattern='grid'] {
    background:
      linear-gradient(rgb(11 111 153 / 0.07) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, rgb(11 111 153 / 0.07) 1px, transparent 1px) 0 0 / 22px 22px,
      #ffffff;
  }
  .service-card[data-pattern='hatch'] {
    background:
      repeating-linear-gradient(135deg, transparent 0 11px, rgb(11 111 153 / 0.07) 11px 12px),
      #f4f9fd;
  }
</style>
