---
import type { Service } from '../../data/home';
import Icon from '../ui/Icon.astro';

type Props = Omit<Service, 'badge'>;
const { icon, title, description } = Astro.props;
---

<a
  href="#contacto"
  class="group hover:border-brand-light-cyan flex flex-col gap-3 rounded-[1.75rem] border border-sky-100 bg-white p-7 shadow-xs transition-[translate,box-shadow,border-color] duration-200 ease-out hover:-translate-y-1 hover:shadow-xl"
>
  <div class="flex items-start justify-between">
    <span class="bg-brand-sky flex size-12 items-center justify-center rounded-xl">
      <Icon name={icon} class="text-brand-blue size-6" />
    </span>
    <span
      class="text-brand-navy group-hover:bg-brand-navy flex size-10 items-center justify-center rounded-full border border-sky-100 transition-colors group-hover:text-white"
      aria-hidden="true"
    >
      <Icon name="arrow-right" class="size-4 -rotate-45" />
    </span>
  </div>
  <h3 class="text-brand-navy pt-8 text-lg font-extrabold">{title}</h3>
  <p class="text-[0.9375rem] leading-relaxed text-slate-600">{description}</p>
  <span class="sr-only">Pedir presupuesto</span>
</a>
