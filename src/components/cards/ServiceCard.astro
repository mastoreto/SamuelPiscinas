---
import type { Service } from '../../data/home';
import Icon from '../ui/Icon.astro';

type Props = Service;
const { icon, title, description, badge } = Astro.props;
---

<article
  class:list={[
    'flex flex-col gap-3 rounded-[1.75rem] bg-white p-7',
    badge
      ? 'border-brand-light-cyan border-[1.5px] shadow-xl'
      : 'border border-sky-100 shadow-xs',
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <span class="bg-brand-sky flex size-12 items-center justify-center rounded-xl">
      <Icon name={icon} class="text-brand-blue size-6" />
    </span>
    {badge && (
      <span class="rounded-full bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-800">
        {badge}
      </span>
    )}
  </div>
  <h3 class="text-brand-navy text-lg font-extrabold">{title}</h3>
  <p class="text-[0.9375rem] leading-relaxed text-slate-600">{description}</p>
  <a
    href="#contacto"
    class="text-brand-link mt-auto border-t border-slate-100 pt-4 text-sm font-bold hover:underline"
  >
    Pedir presupuesto →
  </a>
</article>
