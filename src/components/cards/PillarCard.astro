---
// Tarjeta de "Por qué Samuel". La variante "featured" es la oscura: en vez de foto,
// enseña lecturas de ejemplo sobre su rango correcto (el <slot/> recibe ReadingScale).
import BulletList from '../ui/BulletList.astro';

type Props = {
  title: string;
  description: string;
  bullets?: readonly string[];
  variant?: 'light' | 'featured';
  animatedBullets?: boolean;
  class?: string;
};

const { title, description, bullets, variant = 'light', animatedBullets = false, class: className } = Astro.props;
const featured = variant === 'featured';
---

<article
  class:list={[
    'flex flex-col gap-3 rounded-[1.75rem_1.75rem_1.75rem_0.5rem] p-6',
    featured ? 'bg-brand-navy text-white shadow-[0_18px_40px_-22px_rgb(7_26_46/0.6)]' : 'border border-line bg-wash',
    className,
  ]}
>
  <h3 class:list={['text-2xl leading-tight font-bold', featured ? 'text-white' : 'text-brand-navy']}>
    {title}
  </h3>
  <p class:list={['text-[0.9375rem] leading-relaxed', featured ? 'text-slate-300' : 'text-ink-600']}>
    {description}
  </p>

  {bullets && (
    <div class="mt-auto border-t border-line pt-4">
      <BulletList items={bullets} animated={animatedBullets} />
    </div>
  )}
  {(featured || Astro.slots.has('default')) && (
    <div class:list={[featured ? 'my-auto' : 'mt-auto']}>
      <slot />
    </div>
  )}
</article>
