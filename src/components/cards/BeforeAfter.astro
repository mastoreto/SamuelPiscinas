---
// Comparador antes/después: el <input type="range"> transparente captura el arrastre
// (y el teclado) y el script sólo pasa su valor a --pos.
import { Image } from 'astro:assets';

type Props = {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
  afterLabel?: string;
};

const { before, after, alt, afterLabel = 'Después' } = Astro.props;
---

<div
  data-ba
  class="has-[:focus-visible]:ring-brand-blue relative aspect-[16/11] overflow-hidden rounded-[1.75rem_1.75rem_1.75rem_0.5rem] select-none has-[:focus-visible]:ring-4"
  style="--pos:50%"
>
  <Image src={after} alt={`${alt} (después)`} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 55vw, 100vw" class="absolute inset-0 size-full object-cover" />
  <div class="absolute inset-0" style="clip-path:inset(0 calc(100% - var(--pos)) 0 0)">
    <Image src={before} alt={`${alt} (antes)`} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 55vw, 100vw" class="size-full object-cover" />
  </div>
  <span class="text-brand-navy absolute top-3 left-3 rounded-full bg-white px-3 py-1 text-xs font-extrabold">Antes</span>
  <span class="text-brand-navy absolute top-3 right-3 rounded-full bg-white px-3 py-1 text-xs font-extrabold">{afterLabel}</span>
  <div class="pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-white shadow-card" style="left:var(--pos)">
    <span class="text-brand-navy absolute top-1/2 left-1/2 grid size-11 -translate-1/2 place-items-center rounded-full bg-white text-lg font-extrabold shadow-float" aria-hidden="true">↔</span>
  </div>
  <input type="range" min="0" max="100" value="50" aria-label="Deslizá para comparar antes y después" class="absolute inset-0 size-full cursor-ew-resize opacity-0" />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const input = el.querySelector('input')!;
    input.addEventListener('input', () => el.style.setProperty('--pos', `${input.value}%`));
  });
</script>
