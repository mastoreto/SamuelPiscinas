---
import { poolTypes, serviceOptions } from '../../data/home';
import { contact } from '../../data/site';
import { zonasDepartments } from '../../data/zonas';
import Icon from '../ui/Icon.astro';

// URL del formulario de Formspree (https://formspree.io/f/xxxx) en .env: PUBLIC_FORMSPREE_URL.
// Si falta, el formulario funciona igual solo por WhatsApp.
const formspreeUrl = import.meta.env.PUBLIC_FORMSPREE_URL ?? '';
const departments = [...zonasDepartments.map((d) => d.name), 'Otro departamento'];

const input =
  'focus:border-brand-cyan focus:ring-brand-cyan w-full rounded-[0.875rem_0.875rem_0.875rem_0.25rem] border-slate-300 bg-brand-mist px-4 py-3 text-base text-brand-navy placeholder:text-ink-500 aria-[invalid=true]:border-red-500';
const label = 'text-sm font-bold text-ink-700';
---

<!--
  Abre WhatsApp con el mensaje redactado y, si hay PUBLIC_FORMSPREE_URL, envía además una copia
  por email a través de Formspree. WhatsApp se abre primero: tras un await el navegador bloquearía la ventana.
  El formulario es hijo de la cuadrícula de Contact.astro.
-->
<form
  class="text-brand-navy flex flex-col gap-6 p-7 lg:col-start-2 lg:row-start-1 lg:p-11"
  aria-describedby="form-error"
  data-lead-form
  data-formspree={formspreeUrl}
  data-whatsapp={contact.whatsappNumber}
  novalidate
>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label class={label} for="nombre">Nombre</label>
      <input class={input} id="nombre" name="nombre" type="text" maxlength="100" autocomplete="name" placeholder="Cómo te llamás" required />
    </div>
    <div class="flex flex-col gap-2">
      <label class={label} for="telefono">Teléfono</label>
      <input class={input} id="telefono" name="telefono" type="tel" maxlength="100" autocomplete="tel" placeholder="099 123 456" required />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label class={label} for="tipo">Tipo de piscina</label>
      <select class={input} id="tipo" name="tipo">
        {poolTypes.map((t) => (
          <option value={t.label}>{t.label}</option>
        ))}
      </select>
    </div>
    <div class="flex flex-col gap-2">
      <label class={label} for="departamento">Departamento</label>
      <select class={input} id="departamento" name="departamento" required>
        <option value="">Elegí uno</option>
        {departments.map((name) => (
          <option value={name}>{name}</option>
        ))}
      </select>
    </div>
    <div class="flex flex-col gap-2">
      <label class={label} for="localidad">Localidad o barrio</label>
      <input class={input} id="localidad" name="localidad" type="text" maxlength="100" autocomplete="address-level2" placeholder="Dónde está la piscina" required />
    </div>
    <div class="flex flex-col gap-2">
      <label class={label} for="servicio">¿Qué necesitás?</label>
      <select class={input} id="servicio" name="servicio" required>
        <option value="">Elegí una opción</option>
        {serviceOptions.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label class={label} for="mensaje">
      Algo más que quieras contarme <span class="font-normal text-ink-500">(opcional)</span>
    </label>
    <textarea class={input} id="mensaje" name="mensaje" rows="2" maxlength="1000" placeholder="Tamaño aproximado, si es de sal, qué le pasa..."></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm leading-relaxed text-ink-600">
    <input type="checkbox" name="privacidad" required class="text-brand-deep focus:ring-brand-cyan mt-0.5 size-4.5 rounded border-slate-300" />
    <span>
      He leído la{' '}
      <a href="/privacidad" target="_blank" class="text-brand-link font-semibold underline">política de privacidad</a>{' '}
      y acepto que usen mis datos para responder a mi solicitud.
    </span>
  </label>

  <p class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert" id="form-error" data-form-error></p>

  <!-- Trampa anti-spam: las personas no lo ven ni lo rellenan -->
  <div class="hidden" aria-hidden="true">
    <label>No rellenar <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <!-- Vista previa: el mensaje tal como le llega a Samuel, armado mientras se completa -->
  <div class="flex flex-col gap-2">
    <p class="text-sm font-bold text-ink-700">Así le llega a Samuel</p>
    <div data-preview aria-live="polite" class="rounded-[1rem_1rem_0.25rem_1rem] bg-[#dcf8c6] px-3.5 py-3 text-[0.86rem] leading-snug break-words whitespace-pre-wrap text-[#1f2d1f] shadow-[0_8px_20px_-12px_rgb(7_26_46/0.45)] sm:max-w-md"></div>
  </div>

  <div>
    <button
      type="submit"
      class="bg-brand-navy hover:bg-brand-deep flex w-full items-center justify-center gap-2.5 rounded-[1rem_1rem_1rem_0.3rem] px-6 py-4 text-base font-bold text-white transition-colors active:translate-y-px disabled:opacity-60"
    >
      <Icon name="whatsapp" class="size-5.5" />
      Enviar por WhatsApp
    </button>
    <p class="mt-3 text-center text-xs text-ink-500">Se abre WhatsApp con tu mensaje ya escrito; solo tenés que enviarlo.</p>
  </div>

  <p class="hidden rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" role="status" data-form-ok>
    <span data-form-status>Se ha abierto WhatsApp con tu mensaje. Solo tenés que pulsar Enviar.</span>
    <a href="#" class="text-brand-link block pt-1 underline" target="_blank" rel="noopener noreferrer" data-form-fallback>
      ¿No se ha abierto? Tocá acá para abrir WhatsApp
    </a>
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const error = form?.querySelector<HTMLElement>('[data-form-error]');
  const ok = form?.querySelector<HTMLElement>('[data-form-ok]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitHtml = submit?.innerHTML ?? '';

  // Formato de WhatsApp: *negrita* y viñetas, para que Samuel lo lea de un vistazo.
  const buildLines = (field: (name: string) => string) => {
    const lines = [
      'Hola Samuel, te escribo desde la web para pedir un presupuesto.',
      '',
      '*Datos de contacto*',
      `• Nombre: ${field('nombre')}`,
      `• Teléfono: ${field('telefono')}`,
      '',
      '*Mi piscina*',
      `• Tipo: ${field('tipo')}`,
      `• Departamento: ${field('departamento')}`,
      `• Localidad: ${field('localidad')}`,
      `• Necesito: ${field('servicio')}`,
    ];
    const details = field('mensaje');
    if (details && details !== '…') lines.push('', '*Detalles*', details);
    lines.push('', '¡Gracias!');
    return lines;
  };

  const escape = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  const renderPreview = () => {
    if (!form || !preview) return;
    const data = new FormData(form);
    const lines = buildLines((n) => String(data.get(n) ?? '').trim() || (n === 'mensaje' ? '' : '…'));
    preview.innerHTML = lines
      .map((l) => escape(l).replace(/^\*(.+)\*$/, '<b>$1</b>').replace(/…$/, '<span class="opacity-45">…</span>'))
      .join('\n');
  };
  form?.addEventListener('input', renderPreview);
  form?.addEventListener('change', renderPreview);
  renderPreview();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    ok?.classList.add('hidden');

    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const invalid = form.querySelector<HTMLInputElement>(':invalid');
    if (invalid) {
      const messages: Record<string, string> = {
        nombre: 'Falta tu nombre.',
        telefono: 'Falta un teléfono para poder contestarte.',
        localidad: 'Indicá en qué localidad o barrio está la piscina.',
        departamento: 'Elegí el departamento.',
        servicio: 'Elegí qué necesitás.',
        privacidad: 'Aceptá la política de privacidad para poder enviar la solicitud.',
      };
      form.querySelectorAll(':invalid').forEach((el) => el.setAttribute('aria-invalid', 'true'));
      if (error) {
        error.textContent = messages[invalid.name] ?? 'Revisa los campos obligatorios.';
        error.classList.remove('hidden');
      }
      invalid.focus();
      return;
    }
    error?.classList.add('hidden');

    const data = new FormData(form);
    const lines = buildLines((n) => String(data.get(n) ?? '').trim());
    const url = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`;
    // Sin 'noopener' en features: con él window.open devuelve null siempre y no sabríamos si se bloqueó.
    form.querySelector<HTMLAnchorElement>('[data-form-fallback]')?.setAttribute('href', url);
    const tab = window.open(url, '_blank');
    if (tab) tab.opener = null;
    else window.location.href = url;
    ok?.classList.remove('hidden');
    const whatsappOnly = 'Se ha abierto WhatsApp con tu mensaje. Solo tenés que pulsar Enviar.';
    if (status) status.textContent = whatsappOnly;

    const endpoint = form.dataset.formspree;
    if (!endpoint) return;

    // Copia por email: si falla, el pedido igualmente llega por WhatsApp.
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Enviando…';
    }
    fetch(endpoint, {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' },
      signal: AbortSignal.timeout(10000),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        if (status) status.textContent = `${whatsappOnly} También te hemos enviado la solicitud por email.`;
      })
      .catch(() => {
        if (status) status.textContent = `${whatsappOnly} El envío por email falló: confirma con el mensaje de WhatsApp.`;
      })
      .finally(() => {
        if (submit) {
          submit.disabled = false;
          submit.innerHTML = submitHtml;
        }
      });
  });
</script>
