---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'light' | 'whatsapp';
type Size = 'md' | 'lg';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: Variant;
  size?: Size;
};

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-brand-navy hover:bg-brand-blue text-white shadow-lg',
  light: 'bg-brand-light-cyan text-brand-navy hover:bg-white',
  whatsapp: 'bg-emerald-700 text-white hover:bg-emerald-800',
};

const sizes: Record<Size, string> = {
  md: 'px-6 py-3.5 text-sm',
  lg: 'px-7 py-4 text-base',
};
---

<a
  href={href}
  class:list={[
    'focus-visible:outline-brand-link inline-flex items-center justify-center gap-2 rounded-xl font-bold whitespace-nowrap transition-[color,background-color,border-color,translate] duration-150 ease-out outline-offset-2 focus-visible:outline-2 active:translate-y-px',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
