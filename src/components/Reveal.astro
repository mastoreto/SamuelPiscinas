---
// Revelado al hacer scroll: lo que está bajo el pliegue sube y aparece al entrar en pantalla.
// Lo visible al cargar no se toca, y sin JS o con "reducir movimiento" todo se ve de entrada.
---

<style is:global>
  .reveal-pending {
    opacity: 0;
    transform: translateY(18px);
  }
  .reveal {
    transition:
      opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    transition-delay: var(--d, 0s);
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.remove('reveal-pending');
          // Al terminar se quita la transición para no interferir con los hover.
          el.addEventListener('transitionend', () => el.classList.remove('reveal'), { once: true });
          io.unobserve(el);
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );

    document
      .querySelectorAll<HTMLElement>('main > section:not(#inicio) > div > *')
      .forEach((block) => {
        // En una cuadrícula entra cada hija con un pequeño desfase.
        const items = block.classList.contains('grid') ? [...block.children] : [block];
        items.forEach((el, i) => {
          const item = el as HTMLElement;
          if (item.getBoundingClientRect().top < innerHeight * 0.9) return;
          item.style.setProperty('--d', `${Math.min(i, 4) * 0.08}s`);
          item.classList.add('reveal', 'reveal-pending');
          io.observe(item);
        });
      });
  }
</script>
