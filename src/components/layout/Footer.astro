---
import { Image } from 'astro:assets';
import { footerColumns, legalLinks } from '../../data/home';
import { contact, images, site, whatsappHref } from '../../data/site';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="panel-dark mx-3 mt-4 mb-3 rounded-[2rem] pt-16 pb-28 text-slate-300 sm:mx-5 md:pb-10 lg:rounded-[2.5rem]">
  <Container>
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 border-b border-white/10 pb-12 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.3fr]">
      <div class="col-span-2 flex flex-col gap-4 md:col-span-1">
        <Image src={images.logoNegativo} alt={site.name} height={88} class="h-11 w-auto self-start" />
        <p class="max-w-sm text-sm leading-relaxed">
          Mantenimiento, tratamiento del agua y reparación de piscinas particulares y de clubes
          deportivos en {contact.zone}.
        </p>
      </div>

      {footerColumns.map((column) => (
        <div>
          <h2 class="mb-4 text-[0.9375rem] font-bold text-white">{column.title}</h2>
          <ul class="space-y-1 text-sm">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-1.5 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2 md:col-span-1">
        <h2 class="mb-4 text-[0.9375rem] font-bold text-white">Contacto</h2>
        <ul class="space-y-1 text-sm">
          <li>
            Teléfono:{' '}
            <a href={contact.phoneHref} class="inline-block py-1.5 hover:text-white">
              {contact.phoneDisplay}
            </a>
          </li>
          <li>
            WhatsApp:{' '}
            <a
              href={whatsappHref()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block py-1.5 hover:text-white"
            >
              {contact.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="inline-block py-1.5 hover:text-white">
              {contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 pt-7 text-sm text-slate-400 sm:flex-row">
      <p>
        © {year} {site.name}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {legalLinks.map((link) => (
          <a href={link.href} class="text-slate-300 transition-colors hover:text-white">
            {link.label}
          </a>
        ))}
        <span>
          Sitio desarrollado por{' '}
          <button type="button" data-dev-open aria-haspopup="dialog" class="text-brand-light-cyan font-bold underline decoration-[#7cd0f2] decoration-[1.5px] underline-offset-4 transition-colors hover:text-white">MastoDev</button>
        </span>
      </div>
    </div>
  </Container>
</footer>

<!-- Tarjeta del desarrollador: <dialog> nativo (foco atrapado, Escape y clic afuera cierran) -->
<dialog
  data-dev-card
  aria-labelledby="dev-title"
  class="m-auto w-[min(92vw,26rem)] rounded-[1.75rem_1.75rem_1.75rem_0.5rem] border-0 bg-white p-0 text-ink-700 shadow-[0_30px_70px_-30px_rgb(7_26_46/0.7)] backdrop:bg-brand-navy/65 backdrop:backdrop-blur-sm"
>
  <div class="relative flex flex-col items-start gap-4 p-7">
    <button type="button" data-dev-close aria-label="Cerrar" class="text-ink-500 hover:text-brand-navy absolute top-4 right-4 flex size-9 items-center justify-center rounded-full transition-colors hover:bg-sky-50">
      <Icon name="close" class="size-5" />
    </button>
    <span class="bg-brand-navy font-display flex size-14 items-center justify-center rounded-full text-xl font-bold text-white" aria-hidden="true">SR</span>
    <div>
      <p class="text-ink-500 text-sm font-semibold">Sitio desarrollado por</p>
      <h2 id="dev-title" class="font-display text-brand-navy text-3xl leading-tight font-bold">MastoDev</h2>
    </div>
    <p class="leading-relaxed">
      Mi nombre es <strong class="text-brand-navy">Santiago Rodriguez</strong> y soy desarrollador fullstack hace más de 10 años. No solo construyo tu web, sino que también te ayudo a proyectar tu marca.
    </p>
    <a
      href="mailto:mastoretodev@gmail.com"
      class="bg-brand-navy hover:bg-brand-deep flex w-full items-center justify-center gap-2.5 rounded-[1rem_1rem_1rem_0.3rem] px-5 py-3.5 font-bold break-all text-white transition-colors"
    >
      <Icon name="mail" class="size-5 shrink-0" />
      mastoretodev@gmail.com
    </a>
  </div>
</dialog>

<script>
  const card = document.querySelector<HTMLDialogElement>('[data-dev-card]');
  document.querySelector('[data-dev-open]')?.addEventListener('click', () => card?.showModal());
  card?.querySelector('[data-dev-close]')?.addEventListener('click', () => card.close());
  // Clic en el fondo oscuro (fuera de la tarjeta) cierra
  card?.addEventListener('click', (e) => {
    if (e.target === card) card.close();
  });
</script>

<!-- Botones fijos en móvil: llamar y WhatsApp siempre a mano -->
<nav
  aria-label="Contacto rápido"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-sky-100 bg-white/95 px-3 pt-2.5 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden"
>
  <a
    href={contact.phoneHref}
    class="text-brand-deep rounded-full border border-line py-3.5 text-center font-bold"
  >
    Llamar
  </a>
  <a
    href={whatsappHref()}
    target="_blank"
    rel="noopener noreferrer"
    class="rounded-full bg-emerald-700 py-3.5 text-center font-bold text-white"
  >
    WhatsApp
  </a>
</nav>
