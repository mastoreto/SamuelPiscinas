---
import { Image } from 'astro:assets';
import { contact, images, navLinks, site } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
---

<header class="group sticky top-0 z-50 border-b border-sky-100 bg-white/95 backdrop-blur-md transition-colors data-over-hero:border-transparent data-over-hero:bg-transparent data-over-hero:backdrop-blur-none">
  <Container class="flex h-18 items-center justify-between gap-4 lg:h-21">
    <a href="#inicio" class="flex items-center py-1 transition-opacity duration-300" data-header-logo>
      <Image
        src={images.logo}
        alt={site.name}
        height={88}
        loading="eager"
        class="h-9 w-auto sm:h-10.5"
      />
    </a>

    <nav
      aria-label="Principal"
      class="hidden items-center gap-6 text-sm font-semibold whitespace-nowrap text-slate-600 group-data-over-hero:text-white group-data-over-hero:[text-shadow:0_1px_8px_rgb(7_26_46/0.55)] md:flex lg:gap-8"
    >
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-brand-deep group-data-over-hero:hover:text-brand-light-cyan transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={`https://instagram.com/${contact.instagramHandle}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-deep hover:text-brand-blue group-data-over-hero:text-white group-data-over-hero:[text-shadow:0_1px_8px_rgb(7_26_46/0.55)] hidden items-center gap-2 text-sm font-bold whitespace-nowrap xl:flex"
      >
        <span class="flex size-8 items-center justify-center rounded-full bg-sky-50 text-sky-600">
          <Icon name="instagram" class="size-4" />
        </span>
        <span>@{contact.instagramHandle}</span>
      </a>
      <Button href="#contacto" class="max-sm:hidden group-data-over-hero:hidden">
        Pedir presupuesto
      </Button>

      <button
        type="button"
        class="text-brand-navy flex size-11 items-center justify-center rounded-full border border-sky-100 bg-white md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" class="size-5" data-icon-open />
        <Icon name="close" class="hidden size-5" data-icon-close />
      </button>
    </div>
  </Container>

  <nav
    id="mobile-nav"
    aria-label="Principal (móvil)"
    class="hidden border-t border-sky-100 bg-white md:hidden"
    data-mobile-nav
  >
    <Container class="flex flex-col gap-1 py-4 text-base font-semibold text-slate-700">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-brand-deep rounded-xl px-3 py-3 hover:bg-sky-50">
          {link.label}
        </a>
      ))}
      <Button href="#contacto" class="mt-2">
        Pedir presupuesto
      </Button>
    </Container>
  </nav>
</header>

<script>
  // El hero ya muestra el sello de marca: el logo de la cabecera aparece al salir de él.
  const hero = document.getElementById('inicio');
  const headerLogo = document.querySelector<HTMLElement>('[data-header-logo]');
  if (hero && headerLogo) {
    new IntersectionObserver(
      ([entry]) => {
        const onHero = entry.intersectionRatio > 0.5;
        headerLogo.classList.toggle('opacity-0', onHero);
        headerLogo.classList.toggle('pointer-events-none', onHero);
        headerLogo.toggleAttribute('inert', onHero);
        headerLogo.closest('header')?.toggleAttribute('data-over-hero', onHero);
      },
      { threshold: [0, 0.5, 1] },
    ).observe(hero);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      panel.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
