---
import { Image } from 'astro:assets';
import { contact, images, navLinks, site, whatsappHref } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

const instagram = `https://instagram.com/${contact.instagramHandle}`;
const linkBase =
  'underline decoration-transparent decoration-[1.5px] underline-offset-[7px] transition-colors hover:text-brand-navy aria-[current=true]:text-brand-navy aria-[current=true]:decoration-brand-cyan aria-[current=true]:[text-decoration-style:wavy] group-data-over-hero:hover:text-white group-data-over-hero:aria-[current=true]:text-white group-data-over-hero:aria-[current=true]:decoration-[#7cd0f2]';
---

<header class="group sticky top-0 z-50" data-header>
  <Container class="flex h-18 items-center py-2.5 lg:h-21 lg:py-3">
    <!-- Barra: transparente sobre el hero y pastilla flotante con sombra al bajar -->
    <div class="flex h-full w-full items-center justify-between gap-4 rounded-full bg-white py-0 pr-2 pl-5 shadow-[0_14px_34px_-14px_rgb(7_26_46/0.5)] transition-[background-color,box-shadow] duration-300 group-data-over-hero:bg-transparent group-data-over-hero:shadow-none group-data-over-hero:pl-0">
      <a href="#inicio" class="flex items-center py-1 transition-opacity duration-300" data-header-logo>
        <Image src={images.logo} alt={site.name} height={88} loading="eager" class="h-8 w-auto sm:h-9" />
      </a>

      <nav
        aria-label="Principal"
        class="hidden items-center text-sm font-semibold whitespace-nowrap text-ink-600 group-data-over-hero:text-white group-data-over-hero:[text-shadow:0_1px_8px_rgb(7_26_46/0.55)] lg:flex lg:gap-5 xl:gap-8"
        data-nav
      >
        {navLinks.map((link) => (
          <a href={link.href} class={linkBase}>{link.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2.5">
        <a
          href={instagram}
          target="_blank"
          rel="noopener noreferrer"
          title={`@${contact.instagramHandle}`}
          aria-label={`Instagram @${contact.instagramHandle}`}
          class="text-brand-deep group-data-over-hero:bg-white flex size-10 items-center justify-center rounded-full bg-sky-50 transition-colors hover:bg-sky-100 max-xl:hidden"
        >
          <Icon name="instagram" class="size-5" />
        </a>
        <a
          href={whatsappHref()}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Escribir por WhatsApp"
          title="Escribir por WhatsApp"
          class="flex size-10 items-center justify-center rounded-full bg-emerald-700 text-white transition-colors hover:bg-emerald-800 group-data-over-hero:hidden max-lg:hidden"
        >
          <Icon name="whatsapp" class="size-5" />
        </a>
        <Button href="#contacto" class="rounded-[999px_999px_999px_6px]! group-data-over-hero:hidden max-sm:hidden ">
          Pedir presupuesto
        </Button>

        <button
          type="button"
          class="text-brand-navy flex size-11 items-center justify-center rounded-full border border-sky-100 bg-white lg:hidden"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Abrir menú"
          data-menu-toggle
        >
          <Icon name="menu" class="size-5" />
        </button>
      </div>
    </div>
  </Container>

  <!-- Menú móvil: hoja completa con enlaces grandes y los canales directos abajo -->
  <div
    id="mobile-nav"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Menú"
    class="panel-dark fixed inset-0 z-60 flex flex-col px-6 pt-4 pb-6 text-white lg:hidden"
    data-mobile-nav
  >
    <button type="button" class="flex size-11 items-center justify-center self-end rounded-full border border-white/40" aria-label="Cerrar menú" data-menu-close>
      <Icon name="close" class="size-5" />
    </button>
    <nav aria-label="Principal (móvil)" class="mt-4 flex flex-col gap-1" data-nav>
      {navLinks.map((link) => (
        <a href={link.href} class="font-display py-1 text-[1.8rem] leading-tight font-bold underline decoration-transparent decoration-2 underline-offset-[7px] aria-[current=true]:decoration-[#7cd0f2] aria-[current=true]:[text-decoration-style:wavy]">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="mt-auto flex items-center gap-3">
      <a href={whatsappHref()} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-full bg-emerald-700 py-3.5 text-center font-bold">
        Escribir por WhatsApp
      </a>
      <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram @${contact.instagramHandle}`} class="flex size-12 items-center justify-center rounded-full border border-white/50">
        <Icon name="instagram" class="size-5" />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // El hero ya muestra el sello de marca: sobre él la barra es transparente y sin logo.
  const hero = document.getElementById('inicio');
  const headerLogo = document.querySelector<HTMLElement>('[data-header-logo]');
  if (hero && headerLogo && header) {
    new IntersectionObserver(
      ([entry]) => {
        const onHero = entry.intersectionRatio > 0.5;
        headerLogo.classList.toggle('opacity-0', onHero);
        headerLogo.classList.toggle('pointer-events-none', onHero);
        headerLogo.toggleAttribute('inert', onHero);
        header.toggleAttribute('data-over-hero', onHero);
      },
      { threshold: [0, 0.5, 1] },
    ).observe(hero);
  }

  // Sección actual: se marca en el menú con una línea ondulada.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav] a')];
  const targets = [...new Set(links.map((a) => a.getAttribute('href')!))]
    .map((href) => ({ href, el: document.querySelector<HTMLElement>(href) }))
    .filter((t): t is { href: string; el: HTMLElement } => !!t.el);
  let ticking = false;
  const spy = () => {
    ticking = false;
    const line = innerHeight * 0.35;
    let current = targets[0]?.href;
    for (const t of targets) if (t.el.getBoundingClientRect().top <= line) current = t.href;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = targets.at(-1)?.href ?? current;
    links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === current)));
  };
  addEventListener('scroll', () => ticking || ((ticking = true), requestAnimationFrame(spy)), { passive: true });
  spy();

  // Menú móvil: hoja completa, con foco atrapado y cierre con Escape o al elegir un enlace.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-mobile-nav]');
  if (toggle && sheet) {
    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) sheet.querySelector<HTMLElement>('[data-menu-close]')?.focus();
      else toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(true));
    sheet.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('nav a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (sheet.hidden) return;
      if (e.key === 'Escape') setOpen(false);
      if (e.key === 'Tab') {
        const items = [...sheet.querySelectorAll<HTMLElement>('a, button')];
        const first = items[0], last = items.at(-1)!;
        if (e.shiftKey && document.activeElement === first) (e.preventDefault(), last.focus());
        else if (!e.shiftKey && document.activeElement === last) (e.preventDefault(), first.focus());
      }
    });
  }
</script>
