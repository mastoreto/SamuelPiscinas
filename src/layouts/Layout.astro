---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { images, site } from '../data/site';

type Props = { title?: string; description?: string; jsonLd?: Record<string, unknown> };

const { title = site.title, description = site.description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: images.pool, width: 1200, height: 630, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="es-UY" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0b2347" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  </head>
  <body class="selection:bg-brand-light-cyan bg-white font-sans text-slate-800 antialiased selection:text-white">
    <a
      href="#contenido"
      class="bg-brand-navy focus:ring-brand-cyan sr-only rounded-full px-5 py-3 text-sm font-bold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-60 focus:ring-2"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
